# ====================================================================
# Smart Civic Guardian - Backend REST API Environment Configuration
# ====================================================================

# Environment: "development" or "production"
FLASK_ENV=production
FLASK_DEBUG=0

# Secret Key (Set to a secure random 32+ character string in production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production

# Server URL & Port (Assigned by cloud host like Render/Railway/Heroku)
PORT=5000
HOST=0.0.0.0
BACKEND_URL=https://smart-civic-guardian-api.example.com

# Allowed Frontend Origins (Comma-separated for CORS with credentials)
FRONTEND_URL=https://smart-civic-guardian-frontend.example.com
CORS_ORIGINS=https://smart-civic-guardian-frontend.example.com,http://localhost:3000,http://127.0.0.1:3000

# Database: Supabase PostgreSQL URL (leave blank to use local SQLite)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Cloud Storage (Optional for persistent photo uploads)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-OR-ANON-KEY]
SUPABASE_BUCKET=civic-complaints

# Email Settings (for password reset emails)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Cryptographic OTP Pepper (Server-side HMAC secret)
OTP_PEPPER=change-this-to-a-cryptographically-random-32-byte-hex-string


