# ====================================================================
# Smart Civic Guardian - Safe Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file with real secrets to GitHub!
# ====================================================================

# Flask Application Secret
SECRET_KEY=replace_with_random_secret

# Supabase PostgreSQL Connection
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:placeholder@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Supabase Storage & API Keys
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
SUPABASE_BUCKET=images

# Google / Gmail SMTP Credentials (for 6-digit OTP verification)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=replace_with_gmail_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com

# Server-side HMAC Secret for 6-Digit OTP Peppered Hashing
OTP_PEPPER=replace_with_otp_pepper_secret

# Frontend & Backend Architecture URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
HOST=127.0.0.1
PORT=5000
FLASK_ENV=development
