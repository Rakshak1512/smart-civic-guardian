# ====================================================================
# Smart Civic Guardian - Frontend Web Service Environment Configuration
# ====================================================================

# Environment
FLASK_ENV=production

# Server Port (Assigned by hosting platform like Render/Railway/Heroku)
PORT=3000
HOST=0.0.0.0

# Frontend Website URL (Your deployed frontend domain)
FRONTEND_URL=https://smart-civic-guardian-frontend.example.com

# Backend REST API URL (Point to your separate deployed Backend API)
BACKEND_URL=https://smart-civic-guardian-api.example.com

# Session secret key
SECRET_KEY=change-this-frontend-secret-key-in-production

